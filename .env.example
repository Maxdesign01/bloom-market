# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (Settings -> API Keys & Webhooks, test mode)
PAYSTACK_SECRET_KEY=sk_test_...

# Mailgun (Sending -> API Keys + your domain)
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=sandbox-....mailgun.org
MAILGUN_REGION=api.mailgun.net
MAILGUN_FROM=My Shop <postmaster@sandbox-....mailgun.org>

# Google OAuth (Google Cloud Console -> Credentials) - pasted into Supabase Auth Providers
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
